{
  "name": "fieldtwin",
  "version": "0.1.0",
  "description": "Local, stateful twins of the software trades and logistics businesses run on. Build and test integrations and AI agents without touching a real customer's account.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickgeorgeseo/fieldtwin.git"
  },
  "homepage": "https://github.com/nickgeorgeseo/fieldtwin#readme",
  "bugs": {
    "url": "https://github.com/nickgeorgeseo/fieldtwin/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "example:sync": "tsx examples/sync-jobber-invoice-to-quickbooks/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "graphql": "^16.14.2",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
