{
  "name": "fieldtwin",
  "version": "0.5.1",
  "description": "Local, stateful twins of the Jobber, Housecall Pro, and QuickBooks Online APIs. Build and test integrations and AI agents against a believable fake business, with resets, rewind, controllable time and failures on demand. No real accounts.",
  "keywords": [
    "quickbooks",
    "quickbooks-online",
    "jobber",
    "housecall-pro",
    "mock-server",
    "api-mocking",
    "integration-testing",
    "testing",
    "digital-twin",
    "field-service",
    "mcp",
    "mcp-server",
    "ai-agents",
    "graphql",
    "webhooks",
    "oauth2"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickgeorgeseo/fieldtwin.git"
  },
  "homepage": "https://nickgeorgeai.com/fieldtwin",
  "bugs": {
    "url": "https://github.com/nickgeorgeseo/fieldtwin/issues"
  },
  "type": "module",
  "bin": {
    "fieldtwin": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenarios"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "build": "tsx scripts/build.ts",
    "prepack": "npm run build",
    "example:sync": "tsx examples/sync-jobber-invoice-to-quickbooks/src/main.ts",
    "conformance": "tsx conformance/cli.ts score",
    "conformance:record": "tsx conformance/cli.ts record",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "graphql": "^16.14.2",
    "hono": "^4.13.13",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
